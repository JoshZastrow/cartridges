# Copy to ~/Github/LibreChat/.env (gitignored there) and fill the four secrets:
#   openssl rand -hex 32   -> CREDS_KEY, JWT_SECRET, JWT_REFRESH_SECRET
#   openssl rand -hex 16   -> CREDS_IV
# librechat/start.sh does this for you on first run.

HOST=localhost
PORT=3080
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

MONGO_URI=mongodb://127.0.0.1:27017/LibreChat

# Only the Journal custom endpoint (librechat.yaml). Add `anthropic` here and
# set ANTHROPIC_API_KEY if a key becomes available.
ENDPOINTS=custom

CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=

ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_UNVERIFIED_EMAIL_LOGIN=true
# Local e2e: the default is 5 registrations per 60 min; the limiter is in-memory and resets on restart.
REGISTER_MAX=100
REGISTER_WINDOW=60
ALLOW_SOCIAL_LOGIN=false

# No Meilisearch / RAG.
SEARCH=false
MEILI_NO_ANALYTICS=true

# Single local process; silences the [schedules] scheduler error at startup.
SCHEDULES_SINGLE_PROCESS=true

DEBUG_LOGGING=true
DEBUG_CONSOLE=false
